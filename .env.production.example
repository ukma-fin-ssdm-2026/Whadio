# Copy to .env on the production host and replace every change-me value.
COMPOSE_PROFILES=core,gpu

# Public HTTPS entry point. The certificate must contain this host name.
WHADIO_PUBLIC_URL=https://whadio.example.com
WHADIO_STORAGE__PUBLIC_ENDPOINT_URL=https://whadio.example.com
TLS_CERTIFICATE=./certs/fullchain.pem
TLS_PRIVATE_KEY=./certs/privkey.pem
# HTTP_PORT=80
# HTTPS_PORT=443

POSTGRES_PASSWORD=change-me-postgres-superuser
WHADIO_DB_OWNER_PASSWORD=change-me-database-owner
WHADIO_DB_APP_PASSWORD=change-me-database-application
WHADIO_DB_NAME=whadio

RABBITMQ_USER=whadio
RABBITMQ_PASSWORD=change-me-broker-administrator
RABBITMQ_ASR_PASSWORD=change-me-asr-broker-user
RABBITMQ_NOTES_PASSWORD=change-me-notes-broker-user

S3_ACCESS_KEY=change-me-storage-access-key
S3_SECRET_KEY=change-me-storage-secret-key
WHADIO_STORAGE__ACCESS_KEY=change-me-storage-access-key
WHADIO_STORAGE__SECRET_KEY=change-me-storage-secret-key
# WHADIO_STORAGE__REGION=us-east-1
# WHADIO_STORAGE__BUCKET=recordings

WHADIO_REGISTRATION_MODE=invite-only
WHADIO_RETENTION_INTERVAL_SECONDS=60
WHADIO_MEETINGS_HOSTED=false

# CPU ASR is the default. Add compose.cuda.yaml to COMPOSE_FILE and set the device to cuda for
# NVIDIA acceleration. The Hugging Face token is needed on the first model download.
WHADIO_ASR__DIARIZATION__HF_TOKEN=change-me-hugging-face-token
WHADIO_ASR__RECOGNIZER=parakeet
# WHADIO_ASR__PARAKEET__MODEL=nemo-parakeet-tdt-0.6b-v3
# WHADIO_ASR__PARAKEET__QUANTIZATION=int8
# WHADIO_ASR__WHISPER__MODEL=large-v2
# WHADIO_ASR__WHISPER__COMPUTE_TYPE=int8
# WHADIO_ASR__WHISPER__BEAM_SIZE=5
# WHADIO_ASR__DIARIZATION__MODEL=pyannote/speaker-diarization-community-1
# WHADIO_ASR__DIARIZATION__EMBEDDING_BATCH_SIZE=8
# WHADIO_ASR__DIARIZATION__DEVICE=cpu
# WHADIO_ASR__LANGUAGES=["uk","en","ru","pl","de","fr","es"]
# WHADIO_ASR__FALLBACK_LANGUAGE=uk
# WHADIO_ASR__MAX_AUDIO_BYTES=524288000
# WHADIO_ASR__MAX_DURATION=PT4H
# WHADIO_ASR__FETCH_TIMEOUT=PT1M
# WHADIO_ASR__SLOTS=1
# WHADIO_ASR__JOB_TIMEOUT=PT2H
# WHADIO_ASR__STARTUP_TIMEOUT=PT30M
# WHADIO_ASR__SHUTDOWN_GRACE=PT1M

# This example uses an external provider, so the Ollama profile and an NVIDIA runtime are not
# required. To self-host Ollama, use provider=ollama, set MODEL, and add ollama to profiles.
WHADIO_NOTES__LLM__PROVIDER=anthropic
WHADIO_NOTES__LLM__MODEL=claude-sonnet-5-5
WHADIO_NOTES__LLM__API_KEY=change-me-provider-key
# WHADIO_NOTES__LLM__EFFORT=medium
# WHADIO_NOTES__LLM__BASE_URL=http://llm-runtime:11434
# WHADIO_NOTES__LLM__NUM_CTX=32768
# WHADIO_NOTES__LLM__KEEP_ALIVE=PT5M
# WHADIO_NOTES__MAX_OUTPUT_TOKENS=16000
# WHADIO_NOTES__MAX_INPUT_TOKENS=100000
# WHADIO_NOTES__CHARS_PER_TOKEN=2.5
# WHADIO_NOTES__CONCURRENCY=4
# WHADIO_NOTES__JOB_TIMEOUT=PT30M
# WHADIO_NOTES__SHUTDOWN_GRACE=PT1M

# Leave every WHADIO_SMTP__ variable unset in invite-only mode to run without email. For a relay,
# set all required values and use verified registration only when email delivery works.
# WHADIO_SMTP__HOST=smtp.example.com
# WHADIO_SMTP__PORT=587
# WHADIO_SMTP__STARTTLS=true
# WHADIO_SMTP__FROM_ADDRESS=whadio@example.com
# WHADIO_SMTP__USERNAME=change-me-smtp-user
# WHADIO_SMTP__PASSWORD=change-me-smtp-password
# WHADIO_SMTP__TIMEOUT=PT30S
# WHADIO_OUTBOX__BATCH_SIZE=50
# WHADIO_OUTBOX__RETRY_BACKOFF=PT1M
# WHADIO_OUTBOX__MAX_RETRY_BACKOFF=PT6H
# WHADIO_OUTBOX__MAX_ATTEMPTS=16
# WHADIO_OUTBOX__RETENTION=P7D

# Set this only for the two-host deployment. Never publish Ollama on a public address.
# OLLAMA_ADDRESS=100.64.0.2
# LLM_RUNTIME_URL=http://100.64.0.2:11434
