{
  "name": "whadio-frontend",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "gen:api": "node scripts/gen-api.ts",
    "gen:routes": "node scripts/gen-routes.ts",
    "capture": "node scripts/capture.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write --error-on-warnings",
    "check:extension": "cd ../extension && biome check --error-on-warnings .",
    "check:extension:fix": "cd ../extension && biome check --write --error-on-warnings .",
    "test:extension": "cd ../extension && vitest run"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "6.0.2",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "openapi-fetch": "0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tanstack/react-query-devtools": "5.106.1",
    "@tanstack/router-generator": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "30.1.3",
    "msw": "3.0.4",
    "openapi-msw": "2.1.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
