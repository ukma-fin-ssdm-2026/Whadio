{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/features/meetings/detail/RecordingPlayer.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            // Recordings have no caption file; the timestamped transcript beside the player stands in.
            "useMediaCaption": "off"
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "@/app/**",
                      "@/routes/**",
                      "@/routeTree.gen",
                      "../../**"
                    ],
                    "message": "A feature imports its own files relatively and never another feature or the app; the app composes features."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "@/app/**",
                      "@/routes/**",
                      "@/routeTree.gen",
                      "../**"
                    ],
                    "message": "A feature imports its own files relatively and never another feature or the app; the app composes features."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/meetings/detail/MeetingDetail.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    // The test fills the export slot the way app/pages/MeetingPage.tsx does, to check it resets per revision.
                    "group": [
                      "@/features/**",
                      "!@/features/export/**",
                      "@/app/**",
                      "@/routes/**",
                      "@/routeTree.gen",
                      "../../**"
                    ],
                    "message": "A feature imports its own files relatively and never another feature or the app; the app composes features."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "@/app/**",
                      "@/routes/**",
                      "@/routeTree.gen",
                      "../../**"
                    ],
                    "message": "Shared code never imports a feature or the app."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
