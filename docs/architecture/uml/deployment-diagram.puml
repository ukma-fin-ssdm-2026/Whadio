@startuml deployment-diagram
title Whadio — deployment diagram (production)

skinparam nodesep 50
skinparam ranksep 70

node "User's computer" as pc {
  node "Chrome (desktop)" as chrome {
    artifact "Whadio extension\n<<Manifest V3>>" as ext
    component "Google Meet tab\n<<third-party page>>" as meet
    artifact "Whadio SPA\n<<React bundle>>" as spa
  }
  component "AI assistant\n<<MCP client>>" as mcpClient
}

node "Main host\n<<Linux VM, CPU only>>" as main {
  node "Docker Compose — profile: core" as composeCore {
    component "nginx\n<<reverse proxy, TLS, SPA static>>" as nginx
    component "web\n<<container>>" as web
    component "scheduler\n<<container>>" as scheduler
    component "notes-worker\n<<container>>" as notesWorker
    queue "rabbitmq\n<<container>>" as mq
    database "postgres\n<<container, volume>>" as db
    database "object-storage\n<<container, volume, S3-compatible>>" as store
  }
}

node "GPU host\n<<Linux, NVIDIA GPU>>" as gpu {
  node "Docker Compose — profile: gpu" as composeGpu {
    component "asr-worker\n<<container>>" as asrWorker
    component "llm-runtime\n<<container: Ollama>>" as llm
  }
}

cloud "LLM provider API\n<<Anthropic / OpenAI / Google>>" as provider
cloud "SMTP relay" as smtp

' --- Clients: nginx is the only public entry point ---
ext --> nginx : HTTPS 443\nCapture API\n[TB-1]
spa --> nginx : HTTPS 443\nWeb API\n[TB-1]
mcpClient --> nginx : HTTPS 443\nMCP\n[TB-1]
ext .left.> meet : DOM read\n(names, active speaker)\n[TB-2]

' --- Inside the main host ---
nginx --> web : HTTP\n[TB-3]
web --> db : SQL\n[TB-4]
web --> store : S3 API\n[TB-4]
web --> mq : AMQP\n[TB-5]
scheduler --> db : SQL\n[TB-4]
scheduler --> store : S3 API\n[TB-4]
scheduler --> mq : AMQP\n[TB-5]
notesWorker --> mq : AMQP\n[TB-5]

' --- Between the hosts: everything travels over the private network ---
gpu == main : <<private network>>
asrWorker --> mq : AMQP\n[TB-6]
asrWorker --> store : HTTPS GET, presigned URL\n[TB-6]
notesWorker --> llm : HTTP /api/chat\n[TB-6]

' --- Egress to third parties ---
notesWorker --> provider : HTTPS\nonly when the Owner configured a key\n[TB-7]
web --> smtp : SMTP + STARTTLS\n[TB-8]

note bottom of gpu
  The GPU host opens no public ports and reaches
  the main host only over the private network.
  It holds no database or storage credentials:
  audio is fetched through presigned URLs.
end note

note bottom of main
  Only nginx (443) and the private network's endpoint
  are exposed. Single-host deployment runs both Compose
  profiles on one GPU machine, without the private network.
end note

legend right
  [TB-1] User-controlled clients to public Whadio entry point
  [TB-2] Extension to third-party Google Meet page
  [TB-3] TLS-terminating proxy to internal web app
  [TB-4] Application services to persistent stores
  [TB-5] Application services/workers to message broker
  [TB-6] Main host to lower-trust GPU host over private mesh
  [TB-7] Whadio to external BYOK LLM provider
  [TB-8] Whadio to external SMTP relay
endlegend
@enduml
