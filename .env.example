# Copy to .env. The values are for local development only.
COMPOSE_PROFILES=core

POSTGRES_PASSWORD=whadio-dev-superuser
WHADIO_DB_OWNER_PASSWORD=whadio-dev-owner
WHADIO_DB_APP_PASSWORD=whadio-dev-app

# Match WHADIO_DB_PORT to POSTGRES_PORT when overridden.
WHADIO_DB_HOST=localhost
WHADIO_DB_PORT=5432
WHADIO_DB_NAME=whadio

# A disposable, migrated database for `task test:cov`: export it; tests don't read this file.
# WHADIO_TEST_DATABASE_URL=postgresql+psycopg://whadio_app:password@localhost:55457/whadio_test

RABBITMQ_USER=whadio
RABBITMQ_PASSWORD=whadio-dev-broker
# The Compose workers' own broker users, whadio-asr and whadio-notes.
RABBITMQ_ASR_PASSWORD=whadio-dev-asr
RABBITMQ_NOTES_PASSWORD=whadio-dev-notes

S3_ACCESS_KEY=whadio-dev
S3_SECRET_KEY=whadio-dev-secret

WHADIO_STORAGE__ENDPOINT_URL=http://localhost:8333
# http://seaweedfs:8333 with the ASR worker in Compose; this machine then needs
# `127.0.0.1 seaweedfs` in /etc/hosts to open recording links.
WHADIO_STORAGE__PUBLIC_ENDPOINT_URL=http://localhost:8333
WHADIO_STORAGE__ACCESS_KEY=whadio-dev
WHADIO_STORAGE__SECRET_KEY=whadio-dev-secret
# WHADIO_STORAGE__REGION=us-east-1
# WHADIO_STORAGE__BUCKET=recordings
WHADIO_RETENTION_INTERVAL_SECONDS=60
# true only on the hosted deployment, which caps meetings.
WHADIO_MEETINGS_HOSTED=false

# The web's broker user, also used by a worker run here (`uv run whadio asr-worker`).
WHADIO_BROKER__URL=amqp://whadio:whadio-dev-broker@localhost:5672/whadio
# The web takes results only from these users: comment them out to run a worker here.
WHADIO_ASR_BROKER_USER=whadio-asr
WHADIO_NOTES_BROKER_USER=whadio-notes
# The notes worker needs a provider. The built-in model, served by Ollama (`task llm:up`, NVIDIA
# GPU). The Compose worker calls LLM_RUNTIME_URL below, not BASE_URL; Ollama answers one request
# at a time, so keep CONCURRENCY at 1.
WHADIO_NOTES__LLM__PROVIDER=ollama
WHADIO_NOTES__LLM__MODEL=gemma4:12b-it-qat
WHADIO_NOTES__CONCURRENCY=1
# WHADIO_NOTES__LLM__BASE_URL=http://localhost:11434
# WHADIO_NOTES__LLM__NUM_CTX=32768
# WHADIO_NOTES__LLM__KEEP_ALIVE=PT5M
# Or Claude, which sends transcripts to the Anthropic API, instead of PROVIDER and MODEL above.
# WHADIO_NOTES__LLM__PROVIDER=anthropic
# WHADIO_NOTES__LLM__MODEL=claude-sonnet-5-5
# WHADIO_NOTES__LLM__API_KEY=
# From an account that accepted pyannote/speaker-diarization-community-1's conditions; needed
# until the model is downloaded.
WHADIO_ASR__DIARIZATION__HF_TOKEN=
# parakeet or whisper; only Whisper uses the workspace glossary.
# WHADIO_ASR__RECOGNIZER=parakeet
# Diarization on an NVIDIA GPU, in Compose (`;` on Windows) or here with the cuda extra.
# COMPOSE_FILE=compose.yaml:compose.cuda.yaml
# WHADIO_ASR__DIARIZATION__DEVICE=cuda

# Mail goes to Mailpit, http://localhost:8025; to send none, comment out every WHADIO_SMTP__ line.
# A real relay needs STARTTLS for credentials. WHADIO_PUBLIC_URL is where mail and export links
# point; a relay requires it.
WHADIO_PUBLIC_URL=http://localhost:3000
# Optional API deployment base before /api/v1; defaults to WHADIO_PUBLIC_URL.
# WHADIO_API_PUBLIC_URL=https://api.example/service
WHADIO_SMTP__HOST=127.0.0.1
WHADIO_SMTP__PORT=1025
WHADIO_SMTP__STARTTLS=false
WHADIO_SMTP__FROM_ADDRESS=whadio@localhost
# WHADIO_SMTP__USERNAME=
# WHADIO_SMTP__PASSWORD=
# WHADIO_SMTP__TIMEOUT=PT30S
# A failed notice waits RETRY_BACKOFF, doubling up to MAX_RETRY_BACKOFF.
# WHADIO_OUTBOX__BATCH_SIZE=50
# WHADIO_OUTBOX__RETRY_BACKOFF=PT1M
# WHADIO_OUTBOX__MAX_RETRY_BACKOFF=PT6H
# WHADIO_OUTBOX__MAX_ATTEMPTS=16
# WHADIO_OUTBOX__RETENTION=P7D

# Host ports, if the defaults are taken on your machine.
# POSTGRES_PORT=5432
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# OLLAMA_PORT=11434

# Two hosts only. Ollama has no authentication: publish it on the private network, never 0.0.0.0.
# OLLAMA_ADDRESS=100.64.0.2
# LLM_RUNTIME_URL=http://100.64.0.2:11434
