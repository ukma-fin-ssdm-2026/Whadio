# Copy to .env. The values are for local development only.
COMPOSE_PROFILES=core

POSTGRES_PASSWORD=whadio-dev-superuser
WHADIO_DB_OWNER_PASSWORD=whadio-dev-owner
WHADIO_DB_APP_PASSWORD=whadio-dev-app

RABBITMQ_USER=whadio
RABBITMQ_PASSWORD=whadio-dev-broker

S3_ACCESS_KEY=whadio-dev
S3_SECRET_KEY=whadio-dev-secret

# The workers: `uv run whadio notes-worker`.
WHADIO_BROKER__URL=amqp://whadio:whadio-dev-broker@localhost:5672/whadio
# Your own Anthropic API key; the notes worker refuses to start without one.
WHADIO_NOTES__API_KEY=

# Host ports, if the defaults are taken on your machine.
# POSTGRES_PORT=5432
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
