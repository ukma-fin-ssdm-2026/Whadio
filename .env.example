# Copy to .env. The values are for local development only.
COMPOSE_PROFILES=core

POSTGRES_PASSWORD=whadio-dev-superuser
WHADIO_DB_OWNER_PASSWORD=whadio-dev-owner
WHADIO_DB_APP_PASSWORD=whadio-dev-app

# Backend and Alembic connections. Match WHADIO_DB_PORT to POSTGRES_PORT when overridden.
WHADIO_DB_HOST=localhost
WHADIO_DB_PORT=5432
WHADIO_DB_NAME=whadio

# Optional: application-role URL for a migrated, disposable integration-test database.
# WHADIO_TEST_DATABASE_URL=postgresql+psycopg://whadio_app:password@localhost:55457/whadio_test

RABBITMQ_USER=whadio
RABBITMQ_PASSWORD=whadio-dev-broker
# Each worker in Compose connects as a user of its own, whadio-asr and whadio-notes.
RABBITMQ_ASR_PASSWORD=whadio-dev-asr
RABBITMQ_NOTES_PASSWORD=whadio-dev-notes

S3_ACCESS_KEY=whadio-dev
S3_SECRET_KEY=whadio-dev-secret

# Web recording access and the retention scheduler share object storage.
WHADIO_STORAGE__ENDPOINT_URL=http://localhost:8333
WHADIO_STORAGE__PUBLIC_ENDPOINT_URL=http://localhost:8333
WHADIO_STORAGE__ACCESS_KEY=whadio-dev
WHADIO_STORAGE__SECRET_KEY=whadio-dev-secret
# WHADIO_STORAGE__REGION=us-east-1
# WHADIO_STORAGE__BUCKET=recordings
WHADIO_RETENTION_INTERVAL_SECONDS=60
# Self-hosted instances have no meeting cap; enable only for the hosted deployment.
WHADIO_MEETINGS_HOSTED=false

# The workers: `uv run task workers:up` runs them in Compose with the keys below; `uv run whadio
# notes-worker` and `uv run whadio asr-worker` run them on this machine with this broker URL.
# The ASR worker in Compose reaches storage as seaweedfs:8333, so sign its links for
# http://seaweedfs:8333; a worker run on this machine needs `127.0.0.1 seaweedfs` in /etc/hosts.
WHADIO_BROKER__URL=amqp://whadio:whadio-dev-broker@localhost:5672/whadio
# The web accepts transcription results only from the ASR worker's broker user and notes only
# from the notes worker's. Unset, both are the web's own user: comment these out to run a worker
# on this machine with the broker URL above.
WHADIO_ASR_BROKER_USER=whadio-asr
WHADIO_NOTES_BROKER_USER=whadio-notes
# The notes worker writes with Claude (anthropic, the default) or a model served by Ollama.
# WHADIO_NOTES__LLM__PROVIDER=anthropic
# Your own Anthropic API key; with the anthropic provider the worker refuses to start without one.
WHADIO_NOTES__LLM__API_KEY=
# With ollama: a model pulled on the server, the server's address and the context window.
# WHADIO_NOTES__LLM__MODEL=gemma3:12b
# WHADIO_NOTES__LLM__BASE_URL=http://localhost:11434
# WHADIO_NOTES__LLM__NUM_CTX=32768
# A Hugging Face token of an account that accepted the conditions of
# pyannote/speaker-diarization-community-1; the ASR worker needs it until the model is downloaded.
# Afterwards HF_HUB_OFFLINE=1 in the worker's environment (not in this file) keeps it offline.
WHADIO_ASR__DIARIZATION__HF_TOKEN=
# parakeet or whisper; only Whisper uses the workspace glossary.
# WHADIO_ASR__RECOGNIZER=parakeet

# Host ports, if the defaults are taken on your machine.
# POSTGRES_PORT=5432
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
